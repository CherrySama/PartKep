<mujoco model="panda scene">
  <include file="panda.xml"/>

  <statistic center="0.5 0 0.4" extent="1"/>

  <!-- 更稳定的模拟参数 -->
  <option timestep="0.001" 
          solver="Newton" 
          iterations="200" 
          tolerance="1e-9"
          integrator="Euler"
          cone="pyramidal"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="mat_table" rgba="0.75 0.60 0.42 1"/>
    <material name="mat_tray"  rgba="0.45 0.65 0.50 1"/>

    <!-- bottle mesh: place bottle.stl in assets/franka_emika_panda/assets/ -->
    <mesh name="bottle_mesh" file="bottle.stl"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <!-- floor + table -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          solref="0.03 1" solimp="0.9 0.95 0.001"/>

    <geom name="table" type="box" size="0.3 0.4 0.2"
          pos="0.5 0 0.2" material="mat_table"
          solref="0.03 1" solimp="0.9 0.95 0.001"
          contype="1" conaffinity="1"/>

    <!-- bottle: bottom at local z=-0.065; body z=0.47 puts bottom at 0.405 (just above table at 0.4) -->
    <body name="bottle" pos="0.5 0.05 0.47">
      <joint type="free" name="bottle_free" damping="0.1"/>

      <geom name="bottle_geom" type="mesh" mesh="bottle_mesh"
            rgba="0.72 0.82 0.90 1"
            mass="0.2"
            solref="0.03 1" solimp="0.96 0.99 0.0005"
            margin="0.001" friction="0.95 0.3 0.1"
            contype="1" conaffinity="1"/>

      <site name="kp_body" pos="0.0276 0  0.000" size="0.007" rgba="0 1 0 0"/>
      <site name="kp_neck" pos="0.0123 0  0.068" size="0.007" rgba="1 1 0 0"/>
      <site name="kp_cap"  pos="0      0  0.0951" size="0.007" rgba="0 0 1 0"/>
    </body>

    <!-- tray -->
    <body name="tray" pos="0.5 -0.2 0.406">
      <geom name="tray_surface" type="box" size="0.08 0.08 0.005"
            pos="0 0 0" material="mat_tray"
            solref="0.03 1" solimp="0.9 0.95 0.001"
            contype="1" conaffinity="1"/>
      <site name="kp_tray_surface" pos="0 0 0.007" size="0.007" rgba="1 1 0 1"/>
    </body>

  </worldbody>

  <!-- weld constraint (softened) -->
  <equality>
    <weld name="bottle_weld" body1="bottle" body2="hand" active="false"
          solref="0.02 1" solimp="0.95 0.99 0.001"/>
  </equality>

</mujoco>